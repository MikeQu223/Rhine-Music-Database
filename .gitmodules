# AMD FidelityFX SDK（FSR1 + FSR3.1，含 Vulkan 后端）。MIT 许可。
#
# 说明：git 只把 URL 记录在 .gitmodules，子模块的实际版本由索引里的 gitlink 提交对象
# 决定。前三项已登记为 gitlink；glslang 内部的 spirv-tools / spirv-headers 无法在
# submodule 工作树内再嵌套 gitlink，因此以 pinned-commit 键记录，克隆后按下面两节
# 手工检出对应版本。cmake/FidelityFX.cmake 在配置时会校验 pinned-commit 并给出警告。
#
# 克隆时若直连 github.com 不通，可在地址前加加速站前缀：
#   git -c url."https://v6.gh-proxy.org/https://github.com/".insteadOf="https://github.com/" clone ...
# insteadOf 只在传输时改写，克隆下来的 origin 仍是原始地址，无需事后修改。
[submodule "FidelityFX-SDK"]
	path = FidelityFX-SDK
	url = https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK.git
	branch = v1.1.4
	pinned-commit = c6efa6bf7f2027b3ec94f28578bb5965eabb9e55

[submodule "third_party/dxc"]
	path = third_party/dxc
	url = https://github.com/microsoft/DirectXShaderCompiler.git
	branch = main
	pinned-commit = 1527671533a955c40a7e43a68f767fde734c4cb5

# glslang 是构建期工具依赖：FidelityFX 的 Vulkan 后端把 GLSL 编译成 SPIR-V，而 SDK 只带
# Windows 版 glslangValidator.exe。Rhine 不使用预编译二进制，因此从源码构建，
# 见 cmake/Glslang.cmake。
[submodule "third_party/glslang"]
	path = third_party/glslang
	url = https://github.com/KhronosGroup/glslang.git
	branch = 16.6.0
	pinned-commit = e1b562a8bed273a02f30b59b66a5d499793cede5

# glslang 16.x 不再使用 git submodule：依赖由 third_party/glslang/known_good.json 固定，
# 需手工克隆到 External/ 下。以下两项同样按 pinned-commit 记录版本。
# SPIRV-Tools 必需而非可选：ffx_shader_compiler 给 glslang 传 -Os，SPIR-V 优化实现在
# SPIRV-Tools 里。googletest 不需要（测试关闭）。
[submodule "third_party/glslang/External/spirv-tools"]
	path = third_party/glslang/External/spirv-tools
	url = https://github.com/KhronosGroup/SPIRV-Tools.git
	pinned-commit = ef96ed763b43b59b33b31b362f09a02b729fa1c9

[submodule "third_party/glslang/External/spirv-tools/external/spirv-headers"]
	path = third_party/glslang/External/spirv-tools/external/spirv-headers
	url = https://github.com/KhronosGroup/SPIRV-Headers.git
	pinned-commit = 496543121ce6419f23d6fa5d7194ba66c36212d2

# FFmpeg（LGPL-2.1-or-later）。Linux 包随附自编的仅解码版本，见 scripts/prepare-linux-ffmpeg.cjs。
# 只作为快速克隆使用：源码保持上游原样，不做任何修改，构建一律在 output/ 下 out-of-tree 进行。
# 提交与 pinned-commit 不一致或工作树有改动时，脚本回退到 vendor/ffmpeg/source.json 里的发布包。
#
# git submodule add -b <标签> 在浅克隆下无法检出标签（它会去找 origin/<标签> 分支），
# 因此按下面两步手动检出：
#   git submodule update --init --depth 1 third_party/ffmpeg
#   git -C third_party/ffmpeg fetch --depth 1 origin tag n9.0.1
#   git -C third_party/ffmpeg checkout --detach FETCH_HEAD
[submodule "third_party/ffmpeg"]
	path = third_party/ffmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	branch = n9.0.1
	pinned-commit = bf1b838f2ab88b4f8fd83443325c782ea0e0f7fa
# Qt 6.12.0 源码（Core/Gui/Qml/Quick/Network/Multimedia 所需的最小集合）。
#
# 为什么入库：Qt 6.12 没有公开的 Android 预编译包（download.qt.io 的 Android 组件只到
# 6.6.3），Android kit 只能拿源码自己交叉编译，见 scripts/build-qt-android.cjs。
# 桌面包仍用系统 Qt，不受这些子模块影响。
#
# 构建会在子模块内产生 build/、.gradle/、jar 产物，所以每条都设了 ignore = untracked：
# 这些是构建垃圾，不该让 superproject 的 git status 变脏。
#
# 克隆：浅克隆 + 直接按标签取一份（比 submodule add 少拉一遍默认分支）：
#   git submodule update --init --depth 1 third_party/qt
# 若某个模块卡住，单独重来：
#   git clone --quiet --depth 1 --branch v6.12.0 https://github.com/qt/qtdeclarative.git third_party/qt/qtdeclarative
[submodule "third_party/qt/qtbase"]
	path = third_party/qt/qtbase
	url = https://github.com/qt/qtbase.git
	branch = v6.12.0
	pinned-commit = 025bdad181de241e81bf853c8a2d7bf3d19261a9
	shallow = true
	ignore = untracked
[submodule "third_party/qt/qtdeclarative"]
	path = third_party/qt/qtdeclarative
	url = https://github.com/qt/qtdeclarative.git
	branch = v6.12.0
	pinned-commit = 4332fbbb4c340463dc8cee36dda0c85d932122d8
	shallow = true
	ignore = untracked
[submodule "third_party/qt/qtshadertools"]
	path = third_party/qt/qtshadertools
	url = https://github.com/qt/qtshadertools.git
	branch = v6.12.0
	pinned-commit = bccd516b990a6396900051470ac86cc27a7042ea
	shallow = true
	ignore = untracked
[submodule "third_party/qt/qtsvg"]
	path = third_party/qt/qtsvg
	url = https://github.com/qt/qtsvg.git
	branch = v6.12.0
	pinned-commit = 883a58532078d003cefef0a549bfe9f885ce41f5
	shallow = true
	ignore = untracked
[submodule "third_party/qt/qtmultimedia"]
	path = third_party/qt/qtmultimedia
	url = https://github.com/qt/qtmultimedia.git
	branch = v6.12.0
	pinned-commit = 6ca885f084a3984749d53bb50a0e08bdc60e86cc
	shallow = true
	ignore = untracked
