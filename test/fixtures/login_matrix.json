  "shared": {
    "phases": [
      "idle",
      "preparing",
      "waiting",
      "confirming",
      "failed",
      "complete"
    ],
    "pollIntervalMs": 1000,
    "pollLimit": 300,
    "smsResendMs": 60000,
    "phonePattern": "^1[0-9]{10}$",
    "captchaPattern": "^[0-9]{4,8}$",
    "qrCodes": {
      "expired": 800,
      "waiting": 801,
      "scanned": 802,
      "confirmed": 803
    },
    "retryAfterUnit": "ms",
    "cooldownClock": "wall",
    "scanPromptTemplate": "请用{scanner}扫描并确认登录",
    "loginStatusSuccessTemplate": "已登录：{nickname}",
    "smsSendGuard": "provider==netease && !accountLoading && smsRetrySeconds()==0",
    "statuses": {
      "preparing": "准备二维码…",
      "scanned": "已扫描，请在手机上确认",
      "success": "已登录，可读取我的音乐",
      "expiredNetease": "二维码已过期，请重新生成",
      "timeout": "二维码超时，请重新生成",
      "cancelFailed": "旧二维码取消失败，请稍后重试",
      "smsSent": "验证码已发送，请查看手机短信",
      "smsSending": "正在发送短信验证码…",
      "smsInvalidPhone": "请输入有效的中国大陆手机号码",
      "smsInvalidPair": "请输入中国大陆手机号码和短信验证码",
      "qqDefaultExpired": "二维码会话已失效或登录失败，请重新生成"
    }
