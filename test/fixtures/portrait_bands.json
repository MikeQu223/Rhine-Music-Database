  "imeAndSafeArea": {
    "invariants": [
      "stageScale 只由 layoutWidth 决定：加安全区或 IME 后 stageScale / stageWidth 逐位不变",
      "imeStage = imeBottom / stageScale",
      "containerTop = safe.top / stageScale",
      "左右安全区只收窄 content.width，stageWidth 恒 1080",
      "compress: content 高度减 imeStage，inputShiftStage = 0",
      "shiftUp: inputShiftStage = imeStage，content 高度不减 IME",
      "hit 矩形与 IME 矩形共用同一份内容矩形，不各自算一次"
    ],
    "deviceBlocked": [
      "Android 键盘弹出时窗口是 adjustResize 还是 adjustPan：Qt 全仓 grep windowSoftInputMode 命中 0 次，两个 Activity 都是 sensorLandscape，无证据",
      "真机安全区数值（未测量）",
      "竖屏真机像素基线（Qt 只有 sensorLandscape）"
    ],
    "mustNotZh": "绝不用 MediaQuery.viewInsets 手改 stageScale；Qt 侧不做任何 inset 处理，若平台真的缩小逻辑视口，必须用同一条公式重算。"
