  "phaseMachine": {
    "states": [
      "idle",
      "preparing",
      "waiting",
      "confirming",
      "complete",
      "failed"
    ],
    "legal": [
      "idle -> preparing (startLogin)",
      "preparing -> waiting (prepareQR ready)",
      "preparing -> failed (failLogin)",
      "waiting -> confirming (code 802/803)",
      "waiting -> failed (code 800 / pollCount>=300)",
      "waiting -> idle (cancelLogin)",
      "confirming -> complete (confirmLogin 成功)",
      "confirming -> failed (confirmLogin 失败)",
      "failed -> preparing (startLogin，需 retrySeconds==0)",
      "complete -> idle (logout)"
    ],
    "canRegenerate": "retrySeconds == 0 && phase != preparing && phase != confirming",
    "cancelSemantics": "generation += 1；qr/qrKey 清空；phase = idle；accountLoading = false；QQ 且有旧 key 时 POST /login/qr/cancel 并等待完成屏障，其余 provider 立即完成"
  },
  "assertions": [
    {
      "id": "L-A01",
      "given": "phase == waiting / confirming",
      "expect": "canRegenerateLogin == false",
      "evidence": "MusicAccount.cpp:304-306"
    },
    {
      "id": "L-A02",
      "given": "cancelLogin 被调用（任何 provider）",
      "expect": "generation +1，qr 与 qrKey 清空，phase == idle，且所有后到的旧代响应被丢弃",
      "evidence": "MusicAccount.cpp:352-379"
    },
    {
