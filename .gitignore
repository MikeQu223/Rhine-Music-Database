# FSR 着色器预编译产物：只保留 .h 头文件（供无 dxc/glslang 的环境直接构建），
# 依赖文件 .d 与临时编译脚本 .cmake 每次构建都会重写，不入库。
/generated/**/*.d
/generated/**/*.cmake
# 从源码构建的 dxc 产物（Windows 首次构建会写到这里）。
/generated/dxc/
# 本地临时补丁快照
.uncommitted.diff

# Filament SDK：官方发布包与稀疏源码，体积大且可按文档重新获取。
/third_party/filament-dist/
/third_party/filament-src/
/third_party/filament-*.tgz
