Qt 6.12.0 qtbase 补丁：Android Vulkan Surface 销毁竞态（self-built kit 专用）
============================================================================

背景：真机（ColorOS / OPD2511）后台与前台换面时进程反复死亡。tombstone 实证：
Qt Quick 渲染线程 QRhi::endFrame → vkQueuePresentKHR → android::Surface::
hook_queueBuffer → pthread_mutex_lock 命中已销毁互斥量（FORTIFY SIGABRT；
错开时序为静默 SIGSEGV，exit-info 只有 SIGNALED/11、无 tombstone）。

根因：QAndroidPlatformVulkanWindow::clearSurface() 在 GUI 线程上销毁
VkSurfaceKHR 并释放 ANativeWindow，而渲染线程可能正处于 present 半程；且
Surface 失效时不撤回 expose，surface 重生后 createOrResize 不重查 surface，
界面冻结。

修法：clearSurface() 只标记失效 + 撤回 expose；真正销毁挪到渲染线程
vkSurface()（swapchain 重建的帧间安全点）或窗口析构。隐藏/析构路径
（destroyAndClearSurface）仍立即销毁（渲染线程已停摆）。

应用：submodule third_party/qt/qtbase 工作树已直接修改；若重新克隆：
  git -C third_party/qt/qtbase apply ../../scripts/qtbase-android-vulkan-surface-race.patch
然后重跑 scripts/build-qt-android.cjs 重建 Android Qt。

diff --git a/src/plugins/platforms/android/qandroidplatformvulkanwindow.cpp b/src/plugins/platforms/android/qandroidplatformvulkanwindow.cpp
index e96038a4..a792f7b6 100644
--- a/src/plugins/platforms/android/qandroidplatformvulkanwindow.cpp
+++ b/src/plugins/platforms/android/qandroidplatformvulkanwindow.cpp
@@ -60,11 +60,34 @@ QSurfaceFormat QAndroidPlatformVulkanWindow::format() const
 }
 
 void QAndroidPlatformVulkanWindow::clearSurface()
+{
+    // 系统侧的 Surface 随时可能失效（前台 BLAST 换面同样会触发
+    // onSurfaceChanged(invalid)，不经过任何应用状态切换）。此刻渲染线程可能
+    // 正处于 vkQueuePresentKHR 的半程：若在这里销毁 VkSurfaceKHR 并释放
+    // ANativeWindow，Surface 对象会被从渲染线程脚下抽走——实测 tombstone：
+    // FORTIFY "pthread_mutex_lock called on a destroyed mutex"（Surface::
+    // hook_queueBuffer ← vulkan::driver::QueuePresentKHR ← QRhi::endFrame），
+    // 错开时序则表现为静默 SIGSEGV。
+    //
+    // 因此这里只做两件无竞态的事：
+    //   1. 标记失效；真正的销毁推迟到渲染线程的下一次 vkSurface()（swapchain
+    //      重建发生在帧间，是安全点）或窗口析构（渲染线程已停）。
+    //   2. 对 Qt Quick 撤回 expose。不撤回的话渲染循环会继续向这个已失效的
+    //      surface 出帧，而 surface 重生后 size 未变、swapchainJustBecame-
+    //      Renderable 不翻转，createOrResize 永远不会重查 surface，界面就此
+    //      冻结。撤回 expose 后渲染线程停摆，重 expose 时走 createOrResize
+    //      → vkSurface() → 消费失效标记并换到新 surface。
+    m_vkSurfaceStale = true;
+    QWindowSystemInterface::handleExposeEvent(window(), QRegion());
+}
+
+void QAndroidPlatformVulkanWindow::destroySurfaceResources()
 {
     if (m_vkSurface && m_destroyVkSurface) {
-        m_destroyVkSurface(window()->vulkanInstance()->vkInstance(), m_vkSurface, nullptr);
-        m_vkSurface = 0;
+        if (QVulkanInstance *inst = window()->vulkanInstance())
+            m_destroyVkSurface(inst->vkInstance(), m_vkSurface, nullptr);
     }
+    m_vkSurface = 0;
 
     if (m_nativeWindow) {
         ANativeWindow_release(m_nativeWindow);
@@ -78,7 +101,11 @@ void QAndroidPlatformVulkanWindow::destroyAndClearSurface()
 {
     lockSurface();
     destroySurface();
-    clearSurface();
+    // 应用隐藏/窗口析构路径：渲染线程此时已停摆（expose 撤回或应用状态切换
+    // 先行），直接销毁资源是安全的。不能只标记失效——析构之后再没有
+    // vkSurface() 调用来消费标记，资源会泄漏到进程退出。
+    destroySurfaceResources();
+    m_vkSurfaceStale = false;
     unlockSurface();
 }
 
@@ -91,9 +118,14 @@ VkSurfaceKHR *QAndroidPlatformVulkanWindow::vkSurface()
     }
 
     bool needsExpose = false;
+    // 帧间安全点：消费 clearSurface() 标记的失效 surface。本函数由
+    // QRhiSwapChain::createOrResize 在渲染线程上调用，此刻没有 present 在途，
+    // 销毁 VkSurfaceKHR 与 ANativeWindow 不会与渲染竞争。
+    if (m_vkSurfaceStale) {
+        m_vkSurfaceStale = false;
+        destroySurfaceResources();
+    }
     if (!m_vkSurface) {
-        clearSurface();
-
         QMutexLocker lock(&m_surfaceMutex);
         if (!m_androidSurfaceCreated) {
             QtAndroidPrivate::AndroidDeadlockProtector protector(
@@ -128,8 +160,14 @@ VkSurfaceKHR *QAndroidPlatformVulkanWindow::vkSurface()
                         inst->getInstanceProcAddr("vkDestroySurfaceKHR"));
         }
         VkResult err = m_createVkSurface(inst->vkInstance(), &surfaceInfo, nullptr, &m_vkSurface);
-        if (err != VK_SUCCESS)
+        if (err != VK_SUCCESS) {
             qWarning("Failed to create Android VkSurface: %d", err);
+        } else {
+            // 新的 VkSurface + ANativeWindow 对已就位：若创建/等待期间又收到过
+            // 失效事件，其标记针对的是旧对象，就此作废，防止下一次调用误杀
+            // 刚建好的 surface。
+            m_vkSurfaceStale = false;
+        }
 
         needsExpose = true;
     }
diff --git a/src/plugins/platforms/android/qandroidplatformvulkanwindow.h b/src/plugins/platforms/android/qandroidplatformvulkanwindow.h
index 482a4ab1..524c43c9 100644
--- a/src/plugins/platforms/android/qandroidplatformvulkanwindow.h
+++ b/src/plugins/platforms/android/qandroidplatformvulkanwindow.h
@@ -37,12 +37,16 @@ protected:
 
 private:
     void destroyAndClearSurface();
+    void destroySurfaceResources();
 
     ANativeWindow *m_nativeWindow;
     QSurfaceFormat m_format;
     VkSurfaceKHR m_vkSurface;
     PFN_vkCreateAndroidSurfaceKHR m_createVkSurface;
     PFN_vkDestroySurfaceKHR m_destroyVkSurface;
+    // 系统侧已宣告 Surface 失效、但资源尚未销毁（销毁被推迟到渲染线程的
+    // 帧间安全点）。见 qandroidplatformvulkanwindow.cpp 的 clearSurface()。
+    bool m_vkSurfaceStale = false;
 };
 
 QT_END_NAMESPACE
